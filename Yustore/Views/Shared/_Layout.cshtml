<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YUYUEAT</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-warning">
        <div class="container">

            @* Logo *@
            <a class="navbar-brand fw-bold text-white" asp-controller="Home" asp-action="Index">
                🍱 YUYUEAT
            </a>

            @* 手機版折疊按鈕 *@
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                @* 根據登入角色顯示不同選單 *@
                @if (User.Identity!.IsAuthenticated)
                {
                    <ul class="navbar-nav me-auto">

                        @* M3 修復（P-03）：角色/姓名/Email 直接讀 Claims（AppClaimsPrincipalFactory
                           在登入時放進去的），不用再查一次資料庫——RoleRequiredAttribute 如果剛查過，
                           這裡完全不用再查；就算是沒有 RoleRequiredAttribute 保護的頁面，
                           這裡也是零查詢。 *@
                        @{
                            var currentUserFullName = User.FindFirst(Yustore.Services.AppClaimTypes.FullName)?.Value;
                            var currentUserEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                        }

                        @* 老闆選單 *@
                        @if (User.IsInRole(Yustore.Enums.UserRole.Owner.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold"
                                   asp-controller="Owner" asp-action="Index">
                                    🏠 後台首頁
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Owner" asp-action="Menu">
                                    🍜 菜單管理
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Owner" asp-action="Orders">
                                    📋 訂單管理
                                </a>
                            </li>
                        }

                        @* 外送師選單 *@
                        @if (User.IsInRole(Yustore.Enums.UserRole.Driver.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold"
                                   asp-controller="Driver" asp-action="Index">
                                    🏠 後台首頁
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Driver" asp-action="AvailableOrders">
                                    🔍 可接訂單
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Driver" asp-action="MyOrders">
                                    📋 我的訂單
                                </a>
                            </li>
                        }

                        @* 管理員選單 *@
                        @if (User.IsInRole(Yustore.Enums.UserRole.Admin.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold"
                                   asp-controller="Admin" asp-action="Index">
                                    🛠️ 管理後台
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Admin" asp-action="Applications">
                                    📋 審核佇列
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Admin" asp-action="Users">
                                    👥 使用者管理
                                </a>
                            </li>
                        }

                        @* 顧客選單 *@
                        @if (User.IsInRole(Yustore.Enums.UserRole.Customer.ToString()))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold"
                                   asp-controller="Customer" asp-action="Index">
                                    🏠 探索店家
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Customer" asp-action="Cart">
                                    🛒 購物車
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Customer" asp-action="MyOrders">
                                    📋 我的訂單
                                </a>
                            </li>
                        }

                    </ul>

                    @* 右邊：使用者名稱 + 登出 *@
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white"
                               href="#" data-bs-toggle="dropdown">
                                👤 @currentUserFullName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <span class="dropdown-item-text text-muted small">
                                        @currentUserEmail
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    @* 登出用 POST，需要 AntiForgeryToken *@
                                    <form asp-controller="Account"
                                          asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            🚪 登出
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                }
                else
                {
                    @* 未登入：顯示登入/註冊 *@
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Account" asp-action="Login">
                                登入
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold"
                               asp-controller="Account" asp-action="Register">
                                註冊
                            </a>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    @* 主要內容區域 *@
    <main class="pb-5">
        @RenderBody()
    </main>

    @* 頁尾 *@
    <footer class="bg-warning py-3 mt-5">
        <div class="container text-center">
            <span class="text-white">© 2026 YUYUEAT 版權所有</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>