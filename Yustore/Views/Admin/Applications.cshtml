@model Yustore.Models.PagedResult<Yustore.Models.Entities.ApplicationUser>
@{
    ViewData["Title"] = "審核佇列";
}

<div class="container mt-4">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>📋 審核佇列</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">← 回後台</a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">目前沒有待審核的申請。</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>姓名</th>
                        <th>Email</th>
                        <th>身份</th>
                        <th>店家</th>
                        <th>申請時間</th>
                        <th>審核</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td><span class="badge bg-info">@user.Role.GetDisplayName()</span></td>
                            <td>@(user.Restaurant?.Name ?? "—")</td>
                            <td>@user.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <form asp-action="ApproveApplication" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-success btn-sm">核准</button>
                                    </form>

                                    <button type="button" class="btn btn-danger btn-sm"
                                            data-bs-toggle="collapse" data-bs-target="#reject-@user.Id">
                                        退回
                                    </button>
                                </div>

                                <div class="collapse mt-2" id="reject-@user.Id">
                                    <form asp-action="RejectApplication" method="post" class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="text" name="reason" class="form-control form-control-sm"
                                               placeholder="退回理由（必填）" required />
                                        <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap">
                                            確認退回
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", (Yustore.Models.IPagedResultMetadata)Model)
    }
</div>
