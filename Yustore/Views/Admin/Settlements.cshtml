@model Yustore.Models.PagedResult<Yustore.Models.Entities.SettlementBatch>
@{
    ViewData["Title"] = "結算批次管理";
    var now = DateTime.Now;
}

<div class="container mt-4">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>💰 結算批次管理</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">← 回後台</a>
    </div>

    <form asp-action="GenerateSettlementBatches" method="post" class="row g-2 mb-4 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-auto">
            <label class="form-label small mb-0">年</label>
            <input type="number" name="year" class="form-control form-control-sm" value="@now.Year" required />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-0">月</label>
            <input type="number" name="month" min="1" max="12" class="form-control form-control-sm" value="@now.Month" required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">產生／更新結算批次</button>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">目前還沒有任何結算批次。</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>收款人</th>
                        <th>身份</th>
                        <th>年/月</th>
                        <th>金額</th>
                        <th>狀態</th>
                        <th>產生時間</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in Model.Items)
                    {
                        <tr>
                            <td>@batch.Payee?.FullName</td>
                            <td><span class="badge bg-info">@batch.Payee?.Role.GetDisplayName()</span></td>
                            <td>@batch.Year / @batch.Month</td>
                            <td>$@batch.TotalAmount</td>
                            <td><span class="badge bg-secondary">@batch.Status.GetDisplayName()</span></td>
                            <td>@batch.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", (Yustore.Models.IPagedResultMetadata)Model)
    }
</div>
