@model Yustore.Models.PagedResult<Yustore.Models.Entities.ApplicationUser>
@{
    ViewData["Title"] = "使用者管理";
    var roleFilter = ViewBag.RoleFilter as UserRole?;
}

<div class="container mt-4">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>👥 使用者管理</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">← 回後台</a>
    </div>

    <div class="btn-group mb-3">
        <a asp-action="Users" class="btn btn-sm @(roleFilter == null ? "btn-primary" : "btn-outline-primary")">全部</a>
        @foreach (var role in Enum.GetValues<UserRole>())
        {
            <a asp-action="Users" asp-route-role="@role"
               class="btn btn-sm @(roleFilter == role ? "btn-primary" : "btn-outline-primary")">
                @role.GetDisplayName()
            </a>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">沒有符合條件的使用者。</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>姓名</th>
                        <th>Email</th>
                        <th>身份</th>
                        <th>審核狀態</th>
                        <th>帳號狀態</th>
                        <th>註冊時間</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td><span class="badge bg-info">@user.Role.GetDisplayName()</span></td>
                            <td>
                                @if (user.Role == UserRole.Customer)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span class="badge @(user.ApplicationStatus switch
                                                          {
                                                              ApplicationStatus.Approved => "bg-success",
                                                              ApplicationStatus.Rejected => "bg-danger",
                                                              _ => "bg-warning text-dark"
                                                          })">
                                        @user.ApplicationStatus.GetDisplayName()
                                    </span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">啟用中</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">已停權</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                @if (user.Role != UserRole.Admin)
                                {
                                    <form asp-action="SetActive" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                                        <input type="hidden" name="role" value="@roleFilter" />
                                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            @(user.IsActive ? "停權" : "恢復啟用")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", (Yustore.Models.IPagedResultMetadata)Model,
            new ViewDataDictionary(ViewData) { ["RouteValues"] = new RouteValueDictionary
            {
                ["role"] = roleFilter.HasValue ? (UserRole?)roleFilter : null
            } })
    }
</div>
