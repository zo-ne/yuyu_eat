@model Yustore.Models.Entities.Order
@{
    ViewData["Title"] = "付款";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-white text-center">
                    <h4>💵 模擬付款</h4>
                </div>
                <div class="card-body text-center">

                    <h5 class="mb-1">訂單編號</h5>
                    <h3 class="text-warning mb-4">@Model.OrderNumber</h3>

                    @* 訂單明細 *@
                    <div class="text-start mb-4">
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="d-flex justify-content-between">
                                <span>@item.MenuItem?.Name × @item.Quantity</span>
                                <span>$@item.Subtotal</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span>餐費</span>
                            <span>$@Model.FoodTotal</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>外送費</span>
                            <span>$@Model.DeliveryFee</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                            <span>應付總計</span>
                            <span class="text-warning">$@Model.GrandTotal</span>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <strong>📢 付款說明</strong><br />
                        請在外送師送達時，準備
                        <strong class="text-danger fs-5">$@Model.GrandTotal</strong>
                        現金付給外送師。
                    </div>

                    @* 模擬付款按鈕 *@
                    <form asp-action="ConfirmPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <button type="submit"
                                class="btn btn-success w-100 py-3 fw-bold fs-5">
                            ✅ 確認下單（現金付款）
                        </button>
                    </form>

                    <a asp-action="MyOrders" class="btn btn-outline-secondary w-100 mt-2">
                        取消
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>