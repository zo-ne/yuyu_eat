@model Yustore.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "結帳";
}

<div class="container mt-4">
    <h3 class="mb-4">📝 確認訂單</h3>

    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0">送達資訊</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="DeliveryAddress" class="form-label"></label>
                            <input asp-for="DeliveryAddress" class="form-control"
                                   placeholder="請輸入完整送達地址" />
                            <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Note" class="form-label"></label>
                            <textarea asp-for="Note" class="form-control" rows="2"
                                      placeholder="例如：不要辣、備用餐具..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-warning w-100 fw-bold py-2">
                            確認下單 →
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* 訂單摘要 *@
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">訂單摘要</h5>
                </div>
                <div class="card-body">
                    <h6 class="text-muted mb-3">@Model.Cart?.RestaurantName</h6>
                    @foreach (var item in Model.Cart?.Items ?? new())
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>@item.Name × @item.Quantity</span>
                            <span>$@item.Subtotal</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between mb-1">
                        <span>餐費</span>
                        <span>$@Model.Cart?.FoodTotal</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>外送費</span>
                        <span>$@Model.Cart?.DeliveryFee</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                        <span>總計</span>
                        <span class="text-warning">$@Model.Cart?.GrandTotal</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}