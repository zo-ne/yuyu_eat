@model Yustore.Models.Entities.Restaurant
@{
    ViewData["Title"] = Model.Name;
    var cart = ViewBag.Cart as Yustore.ViewModels.CartViewModel;
}

<div class="container mt-4">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @* 店家資訊 *@
    <div class="card mb-4 shadow-sm">
        <div class="row g-0">
            @if (!string.IsNullOrEmpty(Model.LogoUrl))
            {
                <div class="col-md-3">
                    <img src="@Model.LogoUrl" class="img-fluid rounded-start"
                         style="height:200px;object-fit:cover;width:100%;" />
                </div>
            }
            <div class="col">
                <div class="card-body">
                    <h2 class="card-title">@Model.Name</h2>
                    <p class="text-muted">@Model.Description</p>
                    <p class="mb-1">📍 @Model.Address</p>
                    <p class="mb-1">📞 @Model.Phone</p>
                    <div class="mt-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="@(i <= (int)ViewBag.AverageRating ? "text-warning" : "text-muted")">★</span>
                        }
                        <span class="ms-1 text-muted small">
                            @ViewBag.AverageRating 分（@ViewBag.ReviewCount 則評價）
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @* 菜單 *@
        <div class="col-md-8">
            <h4 class="mb-3">🍜 菜單</h4>
            @foreach (var item in Model.MenuItems)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="row g-0">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <div class="col-4">
                                <img src="@item.ImageUrl" class="img-fluid rounded-start"
                                     style="height:120px;object-fit:cover;width:100%;" />
                            </div>
                        }
                        <div class="col">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@item.Name</h6>
                                <p class="text-muted small mb-2">@item.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-warning fw-bold fs-5">$@item.Price</span>
                                    <form asp-action="AddToCart" asp-controller="Customer"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="menuItemId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-warning btn-sm">
                                            ＋ 加入購物車
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* 購物車側邊欄 *@
        <div class="col-md-4">
            <div class="card shadow-sm sticky-top" style="top:20px;">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0">🛒 購物車</h5>
                </div>
                <div class="card-body">
                    @if (cart == null || !cart.Items.Any())
                    {
                        <p class="text-muted text-center py-3">購物車是空的</p>
                    }
                    else
                    {
                        @foreach (var cartItem in cart.Items)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small">@cartItem.Name × @cartItem.Quantity</span>
                                <span class="small fw-bold">$@cartItem.Subtotal</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span>餐費</span>
                            <span>$@cart.FoodTotal</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>外送費</span>
                            <span>$@cart.DeliveryFee</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                            <span>總計</span>
                            <span class="text-warning">$@cart.GrandTotal</span>
                        </div>
                        <a asp-action="Checkout" asp-controller="Customer"
                           class="btn btn-warning w-100 mt-3 fw-bold">
                            前往結帳 →
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">← 回店家列表</a>
    </div>
</div>