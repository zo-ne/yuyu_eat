@model List<Yustore.Models.Entities.Order>
@using Yustore.Enums
@{
    ViewData["Title"] = "訂單管理";
}

<div class="container mt-4">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>📋 訂單管理</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">← 回後台</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">目前還沒有訂單。</div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@order.OrderNumber</strong>
                        <span class="ms-2 badge @GetStatusBadgeClass(order.Status)">
                            @order.Status
                        </span>
                    </div>
                    <small class="text-muted">
                        @order.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                    </small>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>👤 顧客：</strong>@order.Customer?.FullName</p>
                            <p><strong>📍 地址：</strong>@order.DeliveryAddress</p>
                            @if (order.Delivery?.Driver != null)
                            {
                                <p><strong>🛵 外送師：</strong>@order.Delivery.Driver.FullName</p>
                            }
                        </div>
                        <div class="col-md-6">
                            @* 訂單明細 *@
                            @foreach (var item in order.OrderItems)
                            {
                                <div class="d-flex justify-content-between">
                                    <span>@item.MenuItem?.Name × @item.Quantity</span>
                                    <span>$@item.Subtotal</span>
                                </div>
                            }
                            <hr />
                            <div class="d-flex justify-content-between">
                                <span>餐費</span>
                                <span>$@order.FoodTotal</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>外送費</span>
                                <span>$@order.DeliveryFee</span>
                            </div>
                            <div class="d-flex justify-content-between fw-bold">
                                <span>總計</span>
                                <span class="text-warning">$@order.GrandTotal</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* 狀態更新按鈕 *@
                <div class="card-footer d-flex gap-2 flex-wrap">
                    @if (order.Status == OrderStatus.已付款)
                    {
                        <form asp-action="UpdateOrderStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <input type="hidden" name="newStatus" value="@((int)OrderStatus.備餐中)" />
                            <button type="submit" class="btn btn-primary btn-sm">
                                開始備餐
                            </button>
                        </form>
                    }
                    @if (order.Status == OrderStatus.備餐中)
                    {
                        <form asp-action="UpdateOrderStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <input type="hidden" name="newStatus" value="@((int)OrderStatus.待取餐)" />
                            <button type="submit" class="btn btn-warning btn-sm">
                                餐點完成（通知外送師）
                            </button>
                        </form>
                    }
                    @if (order.Status == OrderStatus.已送達 ||
                   order.Status == OrderStatus.完成)
                    {
                        <a asp-controller="Review"
                           asp-action="OrderReviews"
                           asp-route-orderId="@order.Id"
                           class="btn btn-warning btn-sm">
                            ⭐ 評分
                        </a>
                    }

                </div>
            </div>
        }
    }
</div>

@functions {
    string GetStatusBadgeClass(Yustore.Enums.OrderStatus status) => status switch
    {
        OrderStatus.待付款 => "bg-secondary",
        OrderStatus.已付款 => "bg-info",
        OrderStatus.備餐中 => "bg-primary",
        OrderStatus.待取餐 => "bg-warning text-dark",
        OrderStatus.外送中 => "bg-warning text-dark",
        OrderStatus.已送達 => "bg-success",
        OrderStatus.完成 => "bg-success",
        OrderStatus.已取消 => "bg-danger",
        _ => "bg-secondary"
    };
}