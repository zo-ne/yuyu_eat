@using Yustore.Enums
@{
    ViewData["Title"] = "老闆後台";
    var restaurant = ViewBag.Restaurant as Yustore.Models.Entities.Restaurant;
    var recentOrders = ViewBag.RecentOrders as List<Yustore.Models.Entities.Order>;
}

<div class="container mt-4">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🧑‍🍳 @restaurant?.Name 後台</h2>
        <div>
            <a asp-action="Menu" class="btn btn-warning me-2">管理菜單</a>
            <a asp-action="Orders" class="btn btn-outline-warning">查看所有訂單</a>
        </div>
    </div>

    @* 統計卡片 *@
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <h1 class="text-warning">@ViewBag.TodayOrderCount</h1>
                    <p class="text-muted mb-0">今日訂單</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center border-danger">
                <div class="card-body">
                    <h1 class="text-danger">@ViewBag.PendingOrderCount</h1>
                    <p class="text-muted mb-0">待處理訂單</p>
                </div>
            </div>
        </div>
    </div>

    @* 最新訂單列表 *@
    <h5>📋 最新訂單</h5>
    @if (recentOrders == null || !recentOrders.Any())
    {
        <div class="alert alert-info">目前還沒有訂單。</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-warning">
                    <tr>
                        <th>訂單編號</th>
                        <th>顧客</th>
                        <th>金額</th>
                        <th>狀態</th>
                        <th>時間</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in recentOrders!)
                    {
                        <tr>
                            <td>@order.OrderNumber</td>
                            <td>@order.Customer?.FullName</td>
                            <td>$@order.GrandTotal</td>
                            <td>
                                @* 不同狀態顯示不同顏色 *@
                                <span class="badge @GetStatusBadgeClass(order.Status)">
                                    @order.Status.GetDisplayName()
                                </span>
                            </td>
                            <td>@order.CreatedAt.ToString("MM/dd HH:mm")</td>
                            <td>
                                <a asp-action="Orders" class="btn btn-sm btn-outline-secondary">
                                    詳細
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* 這個函式放在頁面最下面，用來決定狀態的顏色 *@
@functions {
    string GetStatusBadgeClass(Yustore.Enums.OrderStatus status) => status switch
    {
        OrderStatus.PendingPayment => "bg-secondary",
        OrderStatus.Paid => "bg-info",
        OrderStatus.Preparing => "bg-primary",
        OrderStatus.ReadyForPickup => "bg-warning text-dark",
        OrderStatus.OutForDelivery => "bg-warning text-dark",
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Completed => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}