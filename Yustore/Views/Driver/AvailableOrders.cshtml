@model List<Yustore.Models.Entities.Order>
@{
    ViewData["Title"] = "可接訂單";
}

<div class="container mt-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>🔍 可接訂單</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">← 回後台</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h5>目前沒有可接的訂單</h5>
            <p class="text-muted">等老闆備餐完成後，訂單會出現在這裡</p>
            <button onclick="location.reload()"
                    class="btn btn-outline-warning mt-2">
                🔄 重新整理
            </button>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var order in Model)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm border-warning">
                        <div class="card-header bg-warning text-white d-flex
                                    justify-content-between">
                            <strong>@order.OrderNumber</strong>
                            <span>$@order.GrandTotal</span>
                        </div>
                        <div class="card-body">
                            <p class="mb-1">
                                🏪 <strong>@order.Restaurant?.Name</strong>
                            </p>
                            <p class="mb-1">
                                👤 顧客：@order.Customer?.FullName
                            </p>
                            <p class="mb-1">
                                📍 @order.DeliveryAddress
                            </p>
                            <p class="mb-2 text-muted small">
                                🕐 @order.CreatedAt.ToString("HH:mm")
                            </p>

                            @* 訂單摘要 *@
                            <div class="bg-light rounded p-2 mb-3 small">
                                @foreach (var item in order.OrderItems)
                                {
                                    <div>@item.MenuItem?.Name × @item.Quantity</div>
                                }
                                <hr class="my-1" />
                                <div class="d-flex justify-content-between">
                                    <span>外送費（你的收入）</span>
                                    <strong class="text-success">$30</strong>
                                </div>
                            </div>

                            @* 接單按鈕 *@
                            <form asp-action="AcceptOrder" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <button type="submit"
                                        class="btn btn-warning w-100 fw-bold"
                                        onclick="return confirm('確定接這筆訂單？')">
                                    🛵 接單！
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>