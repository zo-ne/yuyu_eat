# 複製這個檔案成 .env（同目錄），docker-compose.yml 會自動讀取。
# .env 本身已經在 .gitignore 裡，不會被 commit。

# SQL Server sa 密碼。SQL Server 容器要求至少 8 碼，且要包含大寫、小寫、數字、符號其中三種。
DB_SA_PASSWORD=YourStrong!Passw0rd

# 選填：要測試註冊驗證信功能才需要填，Gmail 應用程式密碼（不是 Gmail 登入密碼）。
# 留空的話寄信會失敗，但不影響其他功能。
EMAIL_APP_PASSWORD=

# 選填：預設 Admin 帳號（沒有自助註冊入口，靠這組帳密在啟動時自動建立，見 Program.cs）。
# 留空會用程式碼裡的預設值（admin@yuyueat.local / ChangeMe123!），部署到公開環境前務必改掉。
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
